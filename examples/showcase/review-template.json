{
  "id": "code-watch",
  "version": 1,
  "renderer_version": 1,
  "requires": [
    "layout.basic",
    "text.bind",
    "progress.bind"
  ],
  "asset_ids": [],
  "widget": {
    "type": "column",
    "gap_dp": 10,
    "children": [
      {
        "type": "text",
        "text": {
          "bind": "/data/eyebrow"
        },
        "style": "caption",
        "max_lines": 1
      },
      {
        "type": "text",
        "text": {
          "bind": "/title"
        },
        "style": "title",
        "max_lines": 2
      },
      {
        "type": "text",
        "text": {
          "bind": "/data/focus"
        },
        "style": "body",
        "max_lines": 2
      },
      {
        "type": "progress",
        "value": {
          "bind": "/data/progress",
          "fallback": 0
        }
      },
      {
        "type": "text",
        "text": {
          "bind": "/data/compact"
        },
        "style": "caption",
        "max_lines": 1
      }
    ]
  },
  "compact_widget": {
    "type": "column",
    "gap_dp": 6,
    "children": [
      {
        "type": "text",
        "text": {
          "bind": "/title"
        },
        "style": "title",
        "max_lines": 1
      },
      {
        "type": "text",
        "text": {
          "bind": "/data/compact"
        },
        "style": "caption",
        "max_lines": 1
      }
    ]
  }
}
