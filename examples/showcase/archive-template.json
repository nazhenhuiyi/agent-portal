{
  "id": "archive-recap",
  "version": 1,
  "renderer_version": 1,
  "requires": [
    "layout.basic",
    "text.bind"
  ],
  "asset_ids": [],
  "widget": {
    "type": "column",
    "gap_dp": 10,
    "children": [
      {
        "type": "text",
        "text": {
          "bind": "/data/eyebrow"
        },
        "style": "caption",
        "max_lines": 1
      },
      {
        "type": "text",
        "text": {
          "bind": "/title"
        },
        "style": "title",
        "max_lines": 2
      },
      {
        "type": "row",
        "gap_dp": 12,
        "children": [
          {
            "type": "column",
            "gap_dp": 4,
            "children": [
              {
                "type": "text",
                "text": {
                  "bind": "/data/photos"
                },
                "style": "title",
                "max_lines": 1
              },
              {
                "type": "text",
                "text": {
                  "value": "已归档照片"
                },
                "style": "caption",
                "max_lines": 1
              }
            ]
          },
          {
            "type": "column",
            "gap_dp": 4,
            "children": [
              {
                "type": "text",
                "text": {
                  "bind": "/data/albums"
                },
                "style": "title",
                "max_lines": 1
              },
              {
                "type": "text",
                "text": {
                  "value": "整理好的相册"
                },
                "style": "caption",
                "max_lines": 1
              }
            ]
          },
          {
            "type": "column",
            "gap_dp": 4,
            "children": [
              {
                "type": "text",
                "text": {
                  "bind": "/data/pending"
                },
                "style": "title",
                "max_lines": 1
              },
              {
                "type": "text",
                "text": {
                  "value": "待确认日期"
                },
                "style": "caption",
                "max_lines": 1
              }
            ]
          }
        ]
      },
      {
        "type": "text",
        "text": {
          "bind": "/data/note"
        },
        "style": "body",
        "max_lines": 2
      }
    ]
  },
  "compact_widget": {
    "type": "column",
    "gap_dp": 6,
    "children": [
      {
        "type": "text",
        "text": {
          "bind": "/title"
        },
        "style": "title",
        "max_lines": 1
      },
      {
        "type": "text",
        "text": {
          "bind": "/data/compact"
        },
        "style": "caption",
        "max_lines": 1
      }
    ]
  }
}
