{
  "name": "agent-portal",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev -- --data-dir ../.local",
    "build:server": "npm --prefix server run build",
    "test:server": "npm --prefix server test",
    "check:protocol": "npm --prefix protocol run check",
    "setup:local": "npm --prefix server run cli -- init --data-dir ../.local",
    "demo": "npm --prefix server run cli -- demo --data-dir ../.local",
    "build:android": "cd clients/android && ./gradlew assembleDebug",
    "test:android": "node scripts/test-android.mjs",
    "portal": "node packages/cli/bin/agent-portal.mjs",
    "test:cli": "npm run build:server && npm --prefix packages/cli test",
    "pack:server": "npm pack ./server",
    "test:server-package": "npm --prefix server run test:package"
  }
}
