{
  "name": "agent-portal-server",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts start",
    "start": "node dist/cli.js start",
    "build": "node scripts/build.mjs",
    "test": "tsx --test test/*.test.ts",
    "cli": "tsx src/cli.ts",
    "format": "prettier --write src test",
    "predev": "node scripts/resources.mjs",
    "precli": "node scripts/resources.mjs",
    "pretest": "node scripts/resources.mjs",
    "prepack": "npm run build",
    "test:package": "node --test test-package/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "11.10.0",
    "fastify": "5.12.3",
    "jsonc-parser": "3.3.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.15.30",
    "prettier": "3.5.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "description": "Self-hosted notification and widget data service for Agent Portal",
  "engines": {
    "node": ">=22 <23"
  },
  "bin": {
    "agent-portal-server": "bin/agent-portal-server.mjs"
  },
  "files": [
    "bin",
    "dist",
    "resources",
    "README.md",
    "deployment"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazhenhuiyi/agent-portal.git",
    "directory": "server"
  }
}
